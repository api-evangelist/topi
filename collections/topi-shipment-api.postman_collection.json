{
  "item": [
    {
      "id": "76c671c4-e19a-48d9-87cc-87fecf02903b",
      "name": "shipment",
      "description": {
        "content": "#### Assets without serial numbers\n\nSome assets might not have a serial number (e.g. accessories). In order to send them with the shipment, explicitly pass an empty string `\"\"` as the `serial_number` for this asset.\n\n> Note, that every asset, that has a **rent option**, requires a serial number even if it has been directly purchased. The request will fail with an according message if such a serial number is missing.\n\n> Also note, that every item of an order has to be shipped for the order to be completed. This can be done in multiple shipments.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c79bfd17-1a08-4530-a5a1-f05b67b1d025",
          "name": "Create a shipment",
          "request": {
            "name": "Create a shipment",
            "description": {
              "content": "Add shipment info for an order. Partial shipments are allowed and will update the order status to \"partially_fulfilled\". All items must have shipment info before an order is considered \"completed\".",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "shipment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "seller-branding:read seller-catalog:edit seller-catalog:read seller-metrics:read seller-offer:edit seller-offer:read seller-order:edit seller-order:read seller-scenario-simulations:run seller-shipment:edit seller-shipping-method:edit seller-shipping-method:read user-info:read"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://identity.topi.eu/oauth2/token"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://identity.topi.eu/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"<regexp>\",\n  \"serial_numbers\": [\n    {\n      \"seller_product_reference\": {\n        \"source\": \"<string>\",\n        \"reference\": \"<string>\"\n      },\n      \"serial_number\": \"<string>\"\n    },\n    {\n      \"seller_product_reference\": {\n        \"source\": \"<string>\",\n        \"reference\": \"<string>\"\n      },\n      \"serial_number\": \"<string>\"\n    }\n  ],\n  \"metadata\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  },\n  \"tracking_url\": \"<uri>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "7a2a4671-e605-4817-b825-3dd2805f6336",
              "name": "OK response.",
