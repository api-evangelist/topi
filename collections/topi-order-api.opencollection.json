                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Sets the status of an existing order to \"rejected\". You can only reject orders that have been in the status \"created\" or \"acknowledged\"."
        },
        {
          "info": {
            "name": "List all orders with pagination",
            "type": "http"
