          "http": {
            "method": "POST",
            "url": "https://seller-api-sandbox.topi-sandbox.eu/v1/orders/:id/reject",
            "params": [
              {
                "name": "id",
                "value": "739b63c2-9e58-4964-b38d-4ebb424de242",
                "type": "path",
                "description": "topi order ID"
