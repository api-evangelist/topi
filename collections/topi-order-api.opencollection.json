              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Sets the status of an existing order to \"confirmed\". You can only accept orders that have been in the status \"created\" or \"acknowledged\"."
        },
