        {
          "id": "426934db-a21a-4749-a405-da2516dcd8d5",
          "name": "Create shipping method",
          "request": {
            "name": "Create shipping method",
            "description": {
              "content": "Creates a shipping method. This is global for all the offers.\n\nReturns HTTP 200 plus basic information about the newly created shipping method.\n\nThe request returns an HTTP Unprocessable Entity when the provided `\"seller_shipping_method_reference\"` is not unique.\n\n## When using in the Sandbox\n\nThe following seller shipping method references are considered to be available and will make the API return an HTTP Unprocessable Entity error.\n\n- `\"Bridges\"`\n\nNote: The sandbox will always return the same fixture regardless of the payload provided.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "shipping-method",
                "method"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "seller-branding:read seller-catalog:edit seller-catalog:read seller-metrics:read seller-offer:edit seller-offer:read seller-order:edit seller-order:read seller-scenario-simulations:run seller-shipment:edit seller-shipping-method:edit seller-shipping-method:read user-info:read"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://identity.topi.eu/oauth2/token"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://identity.topi.eu/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_shipping_method_reference\": \"<string>\",\n  \"is_in_store_pickup\": \"<boolean>\",\n  \"name\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
